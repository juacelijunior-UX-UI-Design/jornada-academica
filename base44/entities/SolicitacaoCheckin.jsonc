{
  "name": "SolicitacaoCheckin",
  "properties": {
    "cpf": {
      "description": "Somente d\u00edgitos (11). Pedidos antigos, feitos pela p\u00e1gina Check-in.",
      "type": "string"
    },
    "curso": {
      "description": "Curso que a pessoa estuda na UNINASSAU.",
      "maxLength": 100,
      "type": "string"
    },
    "decidido_em": {
      "format": "date-time",
      "type": "string"
    },
    "decidido_por": {
      "description": "E-mail do administrador que decidiu.",
      "type": "string"
    },
    "email": {
      "description": "E-mail de quem pede para ser monitor (o mesmo que usar\u00e1 para entrar no sistema).",
      "maxLength": 150,
      "type": "string"
    },
    "matricula": {
      "description": "Matr\u00edcula UNINASSAU (inscri\u00e7\u00e3o pela p\u00e1gina de monitores).",
      "maxLength": 30,
      "type": "string"
    },
    "nome": {
      "description": "Nome completo de quem pede para ser monitor.",
      "maxLength": 150,
      "type": "string"
    },
    "origem": {
      "description": "Onde o pedido foi feito: p\u00e1gina de monitores ou p\u00e1gina Check-in (antiga).",
      "enum": [
        "monitores",
        "checkin"
      ],
      "type": "string"
    },
    "status": {
      "description": "Situa\u00e7\u00e3o do pedido. S\u00f3 o administrador aprova ou recusa.",
      "enum": [
        "pendente",
        "aprovada",
        "recusada"
      ],
      "enumColors": [
        "yellow",
        "green",
        "red"
      ],
      "type": "string"
    },
    "telefone": {
      "description": "Telefone com DDD, somente d\u00edgitos (inscri\u00e7\u00e3o pela p\u00e1gina de monitores).",
      "maxLength": 11,
      "type": "string"
    }
  },
  "required": [
    "nome",
    "email",
    "status"
  ],
  "type": "object",
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}