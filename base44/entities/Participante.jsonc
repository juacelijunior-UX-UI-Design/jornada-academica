{
  "name": "Participante",
  "properties": {
    "apresentou": {
      "description": "Marcado pela equipe quando o trabalho foi apresentado. S\u00f3 quem apresentou recebe o certificado de 20 horas.",
      "type": "boolean"
    },
    "apresentou_em": {
      "description": "Quando a apresenta\u00e7\u00e3o foi marcada.",
      "format": "date-time",
      "type": "string"
    },
    "apresentou_por": {
      "description": "E-mail de quem marcou a apresenta\u00e7\u00e3o.",
      "type": "string"
    },
    "arquivo_nome": {
      "type": "string"
    },
    "arquivo_tamanho": {
      "type": "number"
    },
    "arquivo_uri": {
      "description": "URI privada do arquivo do trabalho.",
      "type": "string"
    },
    "avaliacao": {
      "description": "Decis\u00e3o do professor sobre a submiss\u00e3o. Vazio = aguardando avalia\u00e7\u00e3o.",
      "enum": [
        "pendente",
        "aprovado",
        "negado"
      ],
      "enumColors": [
        "yellow",
        "green",
        "red"
      ],
      "type": "string"
    },
    "avaliacao_motivo": {
      "description": "Justificativa opcional de quem avaliou (principalmente ao negar).",
      "maxLength": 500,
      "type": "string"
    },
    "avaliado_em": {
      "description": "Quando a submiss\u00e3o foi avaliada.",
      "format": "date-time",
      "type": "string"
    },
    "avaliado_por": {
      "description": "E-mail de quem avaliou a submiss\u00e3o.",
      "type": "string"
    },
    "coautores": {
      "description": "Nomes dos co-autores do trabalho (at\u00e9 9).",
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "cpf": {
      "description": "Somente d\u00edgitos (11).",
      "type": "string"
    },
    "curso": {
      "maxLength": 100,
      "type": "string"
    },
    "disciplina": {
      "enum": [
        "APIExt I",
        "APIExt II",
        "APIExt III",
        "APIExt IV",
        "APIExt V",
        "APIExt VI",
        "PIC",
        "Outras"
      ],
      "enumColors": [
        "blue",
        "blue",
        "blue",
        "blue",
        "blue",
        "blue",
        "purple",
        "gray"
      ],
      "type": "string"
    },
    "email": {
      "maxLength": 150,
      "type": "string"
    },
    "formato": {
      "enum": [
        "banner",
        "comunicacao_oral"
      ],
      "enumColors": [
        "green",
        "yellow"
      ],
      "type": "string"
    },
    "instituicao": {
      "maxLength": 150,
      "type": "string"
    },
    "matricula": {
      "description": "Vazia para participantes externos.",
      "type": "string"
    },
    "nome": {
      "description": "Nome do apresentador do trabalho ou do participante.",
      "maxLength": 150,
      "type": "string"
    },
    "resumo": {
      "maxLength": 2000,
      "type": "string"
    },
    "telefone": {
      "description": "Somente d\u00edgitos, com DDD.",
      "type": "string"
    },
    "tipo": {
      "description": "Submiss\u00e3o de aluno da Uninassau, submiss\u00e3o de p\u00fablico externo ou participante (ouvinte, sem trabalho).",
      "enum": [
        "aluno",
        "externo",
        "participante"
      ],
      "enumColors": [
        "blue",
        "purple",
        "green"
      ],
      "type": "string"
    },
    "titulo": {
      "description": "T\u00edtulo do trabalho inscrito.",
      "maxLength": 200,
      "type": "string"
    },
    "token_ingresso": {
      "description": "C\u00f3digo secreto aleat\u00f3rio do QR Code de ingresso (nunca exibir em listas).",
      "type": "string"
    }
  },
  "required": [
    "tipo",
    "nome",
    "email",
    "telefone",
    "cpf"
  ],
  "type": "object",
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}