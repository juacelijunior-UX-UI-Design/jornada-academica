{
  "name": "Sessao",
  "type": "object",
  "properties": {
    "titulo": {
      "type": "string",
      "maxLength": 150
    },
    "data": {
      "type": "string",
      "format": "date",
      "description": "AAAA-MM-DD"
    },
    "hora_inicio": {
      "type": "string",
      "description": "HH:MM"
    },
    "hora_fim": {
      "type": "string",
      "description": "HH:MM"
    },
    "carga_horaria": {
      "type": "number",
      "description": "Horas da sess\u00e3o."
    }
  },
  "required": [
    "titulo",
    "data",
    "carga_horaria"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}